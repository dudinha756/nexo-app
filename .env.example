DATABASE_URL=postgresql://USER:PASSWORD@HOST/nexo?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.YOUR-REGION.neon.tech/nexo/auth
NEON_AUTH_COOKIE_SECRET=generate-a-random-secret-with-at-least-32-characters

# Web Push (production in Vercel; never commit private keys)
VAPID_PUBLIC_KEY=generate-public-p256-key
VAPID_PRIVATE_KEY=generate-private-p256-key
VAPID_SUBJECT=https://nexo-rotina.vercel.app
